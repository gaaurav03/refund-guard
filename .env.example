# Copy to .env and fill in. Never commit .env.
AWS_REGION=ap-southeast-2

# Bedrock (chosen by the bake-off, bench/results/bakeoff.json)
BEDROCK_MODEL_ID=global.amazon.nova-2-lite-v1:0
BEDROCK_FALLBACK_MODEL_ID=openai.gpt-oss-120b-1:0

# Decider: real server, or "fake" for automated tests only
STRANDS_DECIDER_URL=http://127.0.0.1:8099
DECIDER_MODEL=StrandsAgents/strands-decider-2B-qwen3.5-v1-2610
# 3000 on the GPU server; use 30000 when running the real model on a laptop CPU (6-19 s per call)
DECIDER_TIMEOUT_MS=3000

# Decision policy thresholds on Decider's yes/no signals (docs/decision.md section 5)
ARGS_GROUNDED_THRESHOLD=0.50
CONTRADICTED_THRESHOLD=0.60
NON_EVIDENCE_THRESHOLD=0.60
UNCERTAIN_THRESHOLD=0.60
CONCRETE_PROBLEM_THRESHOLD=0.70
OVER_ASK_THRESHOLD=0.60
HIGH_VALUE_ESCALATE_INR=10000

# Data
DDB_TABLE_PREFIX=rg_

# Public demo limits (docs/security.md section 4)
RATE_LIMIT_PER_MIN_IP=30
MAX_MESSAGES_PER_SESSION=20
MAX_SESSIONS_PER_IP_DAY=10
DAILY_BEDROCK_BUDGET_USD=3.00

# Secret: set in the environment / SSM, never here
REVIEWER_TOKEN=
